APP_NAME="PriceScope API"
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Railway Postgres (BD compartida del proyecto 's10-26-equipo-26').
# El host es interno (postgres.railway.internal): levantar antes el túnel SSH local:
#   ssh -i $env:USERPROFILE\.ssh\id_ed25519_railway -o IdentitiesOnly=yes -N -L 55432:localhost:5432 railway-postgres
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:55432/railway

# Alternativa: BD local con Docker (docker-compose up db) — solo para desarrollo sin red
# DATABASE_URL=postgresql+psycopg://pricescope:pricescope@localhost:5435/pricescope
